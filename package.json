{
  "name": "kevv-marketing-app",
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "cd next-app && npm run dev",
    "build": "cd next-app && npm run build",
    "start": "cd next-app && npm run start",
    "check": "node next-app/scripts/check-i18n.mjs && cd next-app && npm run typecheck",
    "check:i18n": "node next-app/scripts/check-i18n.mjs",
    "test": "cd next-app && npm run test",
    "test:harness": "cd next-app && npm run test:harness",
    "test:e2e:smoke": "cd next-app && npm run test:e2e:smoke",
    "format": "prettier --write .",
    "db:push": "node scripts/db-push-if-configured.mjs"
  },
  "devDependencies": {
    "prettier": "^3.8.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.0"
  }
}

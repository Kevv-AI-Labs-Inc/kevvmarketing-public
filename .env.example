# ============================================================
# Kevv Marketing — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# === Database (Railway auto-injects for linked PostgreSQL) ===
DATABASE_URL=postgresql://user:password@host:5432/railway

# === Server ===
PORT=3000
NODE_ENV=production

# === Branding / Public Metadata (optional for forks) ===
# NEXT_PUBLIC_APP_NAME=Kevv Marketing
# NEXT_PUBLIC_APP_SHORT_NAME=Kevv
# NEXT_PUBLIC_COMPANY_NAME=Kevv AI Labs Inc.
# NEXT_PUBLIC_SUPPORT_EMAIL=support@kevv.ai
# NEXT_PUBLIC_PROJECT_URL=https://kevv.ai
# NEXT_PUBLIC_PROJECT_LABEL=kevv.ai

# === Authentication (NextAuth v5) ===
# Required — min 32 chars. NextAuth reads AUTH_SECRET automatically.
AUTH_SECRET=your-auth-secret-here-min-32-chars

# Google OAuth
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Microsoft Entra ID OAuth
AUTH_MICROSOFT_ENTRA_ID_ID=your-microsoft-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=your-microsoft-client-secret
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# === App URL ===
NEXT_PUBLIC_APP_URL=https://marketing.kevv.ai

# === Map Providers ===
# Frontend map renderer: google | none
NEXT_PUBLIC_MAP_UI_PROVIDER=google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-javascript-api-key
# NEXT_PUBLIC_GOOGLE_MAP_ID=

# Route ETA engine (server-side): google | none
MAP_ROUTE_PROVIDER=google
GOOGLE_MAPS_SERVER_API_KEY=your-google-maps-server-key
# MAP_ROUTE_REQUEST_TIMEOUT_MS=15000

# === AI Provider (Azure OpenAI) ===
AI_PROVIDER=openai
OPENAI_API_STYLE=azure

# --- Azure OpenAI Endpoints ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
OPENAI_API_KEY=<azure-openai-key>

# Scoped endpoint overrides (chat / embedding / video can be separate Azure resources):
# AZURE_OPENAI_CHAT_ENDPOINT=https://<chat-resource>.openai.azure.com
# AZURE_OPENAI_CHAT_API_KEY=
# AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<embedding-resource>.openai.azure.com
# AZURE_OPENAI_EMBEDDING_API_KEY=
# AZURE_OPENAI_VIDEO_ENDPOINT=
# AZURE_OPENAI_VIDEO_API_KEY=

# --- Global Model Defaults ---
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Per-Task Model Routing (AI Orchestration Layer) ---
# 强推理任务 → gpt-5.3-chat
AI_TASK_HOME_VALUE_MODEL=gpt-5.3-chat
AI_TASK_PROSPECTING_MODEL=gpt-5.3-chat
AI_TASK_AREA_MAGNET_MODEL=gpt-5.3-chat
# 轻量级任务 → gpt-5.4-mini
AI_TASK_CONTENT_MODEL=gpt-5.4-mini
AI_TASK_CMA_MODEL=gpt-5.4-mini
AI_TASK_SMART_MATCH_MODEL=gpt-5.4-mini
# 嵌入
AI_TASK_EMBEDDING_MODEL=text-embedding-3-small

# Gemini fallback (optional):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# === Email (Resend) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kevv Marketing <noreply@kevv.ai>
# RESEND_REPLY_TO_EMAIL=

# === Cloudflare R2 (File Storage) ===
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=bbo-storage
R2_PUBLIC_URL=https://your-r2-public-domain.com

# === Listing Data Service ===
LISTING_DATA_SERVICE_URL=
LISTING_DATA_SERVICE_API_KEY=

# === API Keys (service-to-service only) ===
# BBO_STATIC_API_KEY=service_sk_xxx
# BBO_STATIC_API_KEYS=service_sk_xxx,service_sk_yyy

# === Webhook Security ===
# WEBHOOK_SECRET=

# === Studios: Cloud Video (optional) ===
# OPENAI_VIDEO_MODEL=sora-2
# OPENAI_VIDEO_API_PATH=/v1/videos
# JIMENG_API_KEY=
# JIMENG_API_BASE_URL=
# JIMENG_VIDEO_MODEL=jimeng-3.0
# JIMENG_VIDEO_API_PATH=/v1/videos

# === Local-only development convenience (do not enable in deploy) ===
# ENABLE_DEV_AUTH_BYPASS=true
# NEXT_PUBLIC_ENABLE_DEV_AUTH_BYPASS=true
